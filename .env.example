# Coldline
# File: .env.example
# Component: Local port configuration
# Purpose: Show optional host-port overrides without storing secrets.
# Interacts With: compose.yaml
# Sprint/Task: Sprint 4 — Project 4
# Concepts: Configuration safety
# Tools: Docker Compose

# Optional host-port overrides. Compose defaults are 8000, 8180, 3000, 9090, 9093, 16686,
# 4566, and 50051. Never store secrets in this file. The LocalStack development credentials
# live in compose.yaml, grant nothing outside the local Compose network, and are not secrets.
# After changing COLDLINE_ISSUER_HOST_PORT, keep config/auth.yaml unchanged: it is supplied,
# and the public check reports a change to it as a boundary violation.
# COLDLINE_GRPC_HOST_PORT is the API's gRPC reading intake; `poe grpc-call`, `poe verify`
# and the harness behind tests/student/test_grpc_ingest.py read it the same way.
COLDLINE_API_HOST_PORT=8000
COLDLINE_ISSUER_HOST_PORT=8180
COLDLINE_GRAFANA_HOST_PORT=3000
COLDLINE_PROMETHEUS_HOST_PORT=9090
COLDLINE_ALERTMANAGER_HOST_PORT=9093
COLDLINE_JAEGER_HOST_PORT=16686
COLDLINE_LOCALSTACK_HOST_PORT=4566
COLDLINE_GRPC_HOST_PORT=50051
